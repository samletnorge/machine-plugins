provider_deepseek = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "community/provider_deepseek" }
provider_github_copilot = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "community/provider_github_copilot" }
provider_google_gemini = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "community/provider_google_gemini" }
provider_grok = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "community/provider_grok" }
provider_groq = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "community/provider_groq" }
