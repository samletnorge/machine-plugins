processor_support = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "framework/processor_support" }
prompt_support = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "framework/prompt_support" }
server_support = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "framework/server_support" }
storage_support = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "framework/storage_support" }
