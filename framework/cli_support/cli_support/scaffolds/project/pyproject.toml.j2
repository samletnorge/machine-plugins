browser_support = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "community/browser_support" }
channel_support = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "community/channel_support" }
deployer_support = { git = "git+ssh://git@github.com/samletnorge/machine-plugins.git", subdirectory = "community/deployer_support" }
