"""{{ agent_name }} agent.

Generated by ``machine agent add {{ agent_name }}`` and backed by the basic
agent runtime (``agent_runtime_basic``).
"""

from __future__ import annotations

from typing import Any

from agent_support.schemas import AgentDefinition

{{ agent_const }} = AgentDefinition(
    name="{{ agent_name }}",
    description="{{ agent_name }} agent",
    model_ref="deepseek/deepseek-chat",
    tool_refs=[],
    instruction=(
        "You are {{ agent_name }}. Respond helpfully and concisely to the "
        "user's request."
    ),
)


class {{ agent_class }}:
    """Runnable agent that delegates to the 'basic' agent runtime."""

    description = "{{ agent_name }} agent (basic runtime)"

    def __init__(self, machine: Any) -> None:
        self._machine = machine

    async def run(self, input: str, context: dict[str, Any] | None = None) -> Any:
        """Run the agent against ``input`` and return its output."""
        runtime = self._machine.resolve("agent", "basic")
        if runtime is None:
            raise RuntimeError(
                "agent_runtime_basic is not loaded; add it to "
                "[tool.machine-core].plugins"
            )
        tools = [
            self._machine.resolve("tool", name)
            for name in {{ agent_const }}.tool_refs
        ]
        result = await runtime.run({{ agent_const }}, input, tools, context)
        return result.output


__all__ = ["{{ agent_const }}", "{{ agent_class }}"]
